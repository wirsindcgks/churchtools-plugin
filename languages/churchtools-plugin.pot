msgstr ""

#: includes/Admin/SettingsPage.php:1565 includes/Admin/SettingsPage.php:2207 includes/Admin/SettingsPage.php:2660
msgid "Standard"
msgstr ""

#: includes/Admin/SettingsPage.php:1566
msgid "Weiche Rundungen, ruhiger Schatten, umrandetes Kalender-Etikett. Die bisherige Optik – wer nichts umstellt, bekommt genau das."
msgstr ""

#: includes/Admin/SettingsPage.php:1569
msgid "Ruhig"
msgstr ""

#: includes/Admin/SettingsPage.php:1570
msgid "Zurückhaltend und architektonisch: feine Linien statt Schatten, fast keine Rundung, keine Bewegung beim Überfahren. Der Kalendername steht als farbiger Text da."
msgstr ""

#: includes/Admin/SettingsPage.php:1573
msgid "Warm"
msgstr ""

#: includes/Admin/SettingsPage.php:1574
msgid "Großzügig und einladend: starke Rundungen, ein weicherer Schatten, mehr Luft zwischen den Kacheln, gefülltes Kalender-Etikett. Beim Überfahren hebt sich die Kachel und das Bild zoomt leicht."
msgstr ""

#: includes/Admin/SettingsPage.php:1577
msgid "Strukturiert"
msgstr ""

#: includes/Admin/SettingsPage.php:1578
msgid "Kontrastreich und redaktionell: rechtwinklig, ohne Schatten, dafür eine kräftige Kante in der Kalenderfarbe und deutliche Trennlinien."
msgstr ""

#: includes/Admin/SettingsPage.php:1640
msgid "Gilt über der gewählten Vorlage: Was hier eingestellt ist, setzt sich gegen sie durch – wer „Eckig“ wählt, bekommt eckige Ecken auch in einer Vorlage mit runden. Für alle Ansichten und jeden Shortcode, Block und WPBakery-Eintrag."
msgstr ""

#: includes/Admin/SettingsPage.php:1647
