{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "churchtools-plugin/event-list",
    "title": "ChurchTools Events",
    "category": "widgets",
    "icon": "calendar-alt",
    "description": "Zeigt synchronisierte ChurchTools Kalender-Events an.",
    "textdomain": "churchtools-plugin",
    "attributes": {
        "calendarIds": { "type": "array", "default": [] },
        "layout": { "type": "string", "default": "list" },
        "limit": { "type": "number", "default": 10 },
        "columns": { "type": "number", "default": 3 },
        "click": { "type": "string", "default": "default" }
    },
    "editorScript": "file:./build/index.js",
    "style": "file:../../assets/css/frontend.css",
    "script": "file:../../assets/js/frontend.js"
}
